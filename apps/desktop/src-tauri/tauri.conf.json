{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divisio",
  "version": "0.1.0",
  "identifier": "dev.divisio.desktop",
  "build": {
    "beforeDevCommand": "bun run scripts/build-daemon.ts && bun run --cwd ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../web build && bun run scripts/build-daemon.ts",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Divisio",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/divisio-daemon"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  }
}
